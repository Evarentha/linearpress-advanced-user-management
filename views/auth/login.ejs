<!--
  Login form: supports error (rate limiting / wrong credentials) and notice
  (such as the email-not-verified prompt).

  @since 1.0.0
-->

<section class="auth"><p class="eyebrow">ACCOUNT ACCESS</p><h1>登录</h1><% if (typeof notice !== 'undefined' && notice) { %><p class="aum-notice"><%= notice %></p><% } %><% if (error) { %><p class="error"><%= error %></p><% } %><form method="post" action="/login"><input name="username" required placeholder="用户名"><input name="password" required type="password" placeholder="密码"><button class="button" type="submit">进入后台</button></form><a href="/register">创建账号 →</a></section>